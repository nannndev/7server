# Copy to server/.env and fill in.
PORT=5001
# Dashboard login. If empty, a random one is generated into server/data/dashboard.password
DASHBOARD_PASSWORD=
# Only needed if the UI is served from a different origin than the API (default: same origin via Vite proxy)
CORS_ORIGIN=
# Google login for the AI gateway (Gemini CLI OAuth app). Leave empty to disable Gemini login.
GEMINI_OAUTH_CLIENT_ID=
GEMINI_OAUTH_CLIENT_SECRET=
