# Copy to .env next to docker-compose.yml. Never commit .env (it is git-ignored).

# First admin password. If empty, a random one is written to /data/dashboard.password
# (read it with: docker compose exec 7server cat /data/dashboard.password)
DASHBOARD_PASSWORD=

# Behind a reverse proxy: which hops may set X-Forwarded-For. Leave empty when nothing is in front.
# nginx on the host reaching the container through Docker's bridge: 172.16.0.0/12
TRUST_PROXY=

# Extra IPs allowed to call the AI gateway (comma separated), besides private networks and your servers.
AI_GATEWAY_ALLOWED_IPS=

# Only set to 1 if every caller on the Docker bridge is trusted (no published ports reachable from the internet).
AI_GATEWAY_TRUST_DOCKER_BRIDGE=

# Google login for the AI gateway (Gemini CLI OAuth app). Empty disables Gemini login.
GEMINI_OAUTH_CLIENT_ID=
GEMINI_OAUTH_CLIENT_SECRET=
